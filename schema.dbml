

Table "users" {
  "id" BIGSERIAL [pk, increment]
  "full_name" VARCHAR(100) [not null]
  "phone_number" VARCHAR(15) [unique, not null]
  "email" VARCHAR(255) [unique]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "booths" {
  "id" BIGSERIAL [pk, increment]
  "user_id" BIGINT [not null]
  "name" VARCHAR(150) [not null]
  "slug" VARCHAR(150) [unique, not null]
  "description" TEXT
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "products" {
  "id" BIGSERIAL [pk, increment]
  "booth_id" BIGINT [not null]
  "title" VARCHAR(255) [not null]
  "description" TEXT
  "price" BIGINT [not null]
  "stock" INT [not null, default: 0]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "carts" {
  "id" BIGSERIAL [pk, increment]
  "user_id" BIGINT [unique, not null]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "cart_items" {
  "id" BIGSERIAL [pk, increment]
  "cart_id" BIGINT [not null]
  "product_id" BIGINT [not null]
  "quantity" INT [not null, default: 1]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (cart_id, product_id) [unique, name: "uq_cart_product"]
  }
}

Table "orders" {
  "id" BIGSERIAL [pk, increment]
  "user_id" BIGINT [not null]
  "total_amount" BIGINT [not null]
  "status" VARCHAR(50) [not null, default: 'pending']
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "order_items" {
  "id" BIGSERIAL [pk, increment]
  "order_id" BIGINT [not null]
  "product_id" BIGINT [not null]
  "quantity" INT [not null]
  "price_at_purchase" BIGINT [not null]
}

Table "wallets" {
  "id" BIGSERIAL [pk, increment]
  "user_id" BIGINT [unique, not null]
  "balance" BIGINT [not null, default: 0]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "wallet_transactions" {
  "id" BIGSERIAL [pk, increment]
  "wallet_id" BIGINT [not null]
  "amount" BIGINT [not null]
  "transaction_type" VARCHAR(50) [not null]
  "idempotency_key" VARCHAR(100) [unique, not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Ref "fk_booth_user":"users"."id" <? "booths"."user_id" [delete: cascade]

Ref "fk_product_booth":"booths"."id" <? "products"."booth_id" [delete: cascade]

Ref "fk_cart_user":"users"."id" <? "carts"."user_id" [delete: cascade]

Ref "fk_item_cart":"carts"."id" <? "cart_items"."cart_id" [delete: cascade]

Ref "fk_item_product":"products"."id" <? "cart_items"."product_id" [delete: cascade]

Ref "fk_order_user":"users"."id" <? "orders"."user_id" [delete: restrict]

Ref "fk_item_order":"orders"."id" <? "order_items"."order_id" [delete: cascade]

Ref "fk_item_order_product":"products"."id" <? "order_items"."product_id" [delete: restrict]

Ref "fk_wallet_user":"users"."id" <? "wallets"."user_id" [delete: cascade]

Ref "fk_transaction_wallet":"wallets"."id" <? "wallet_transactions"."wallet_id" [delete: cascade]
